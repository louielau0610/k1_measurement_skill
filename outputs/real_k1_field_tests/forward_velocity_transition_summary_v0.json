{
  "metadata": {
    "schema_version": "real_k1_forward_velocity_field_test_v0",
    "date": "2026-06-09",
    "platform": "Booster Robotics K1",
    "environment": {
      "floor_type": "lab_hard_floor",
      "condition": "dry"
