{
  "milestone": "M27-D",
  "title": "Booster K1 Isolated SDK Binding and Zero-Motion Audit Closure",
  "created_at": "2026-06-18",
  "binding_class": "BoosterK1VendorBinding",
  "sdk_family": "booster_k1",
  "package_probe_module": "booster_robotics_sdk_python",
  "package_probe_semantics": "diagnostic only; does not prove direct entry modules or classes",
  "sdk_import_path": "B1LocoClient,ChannelFactory,RobotMode",
  "direct_entry_modules": ["B1LocoClient", "ChannelFactory", "RobotMode"],
  "sdk_entry_classes": ["B1LocoClient", "ChannelFactory", "RobotMode"],
  "authoritative_runtime_dependencies": [
    "B1LocoClient.B1LocoClient",
    "ChannelFactory.ChannelFactory",
    "RobotMode.RobotMode"
  ],
  "verified_motion_sequence": ["kPrepare", "kWalking", "Move(vx, 0.0, 0.0)"],
  "verification_sources": [
    "scripts/send_m23b_k1_velocity_command.py",
    "scripts/run_m19c_ros2_odometer_trials.py"
  ],
  "zero_motion_only": true,
  "zero_motion_tolerance": 1e-9,
  "forbidden_velocities_mps": [0.35, 0.40, 0.50, 0.60],
  "binding_version": "m27d.1",
  "vendor_runtime_mode": "vendor_runtime",
  "sdk_import_isolation": {
    "import_guard": "package_probe_and_direct_module_find_spec",
    "import_triggers_only_in_factory": true,
    "direct_import_verification_only_after_explicit_import": true,
    "ordinary_import_safe": true,
    "default_registry_mock_only": true,
    "default_cli_mock_only": true
  },
  "runtime_lifecycle": {
    "connect_idempotent": true,
    "disconnect_idempotent": true,
    "reject_commands_disconnected": true,
    "reject_commands_before_locomotion_ready": true,
    "safe_restoration_on_failure": true,
    "clock_injectable": true
  },
  "verified_sdk_operations": {
    "ChannelFactory_Init": "verified",
    "B1LocoClient_Init": "verified",
    "RobotMode_kPrepare": "verified",
    "RobotMode_kWalking": "verified",
    "Move_zero": "verified_command_call_only",
    "odometry_direct_sdk": "unverified",
    "battery_direct_sdk": "unverified",
    "GetMode": "optional_unverified"
  },
  "zero_motion_state_semantics": {
    "generic_zero_velocity_dispatch": "preserves idle or locomotion-ready state; never marks MOVING",
    "stop": "records command-derived SAFE_STOPPED internal state only",
    "physical_stop_verification": "requires independent post-command telemetry and is not provided by internal state"
  },
  "health_check_scope": {
    "scope": "binding_readiness",
    "communication_verified": false,
    "detail": "binding object and client handle are present; transport communication was not independently verified"
  },
  "hardware_gate_fields": [
    "allow_hardware",
    "operator_confirmed_hardware",
    "hardware_session_id",
    "safety_policy_id",
    "safety_policy_hash",
    "expected_robot_id",
    "expected_adapter_mode",
    "require_physical_estop_confirmation",
    "require_clear_test_area_confirmation",
    "require_battery_state_confirmation",
    "require_network_isolation_confirmation",
    "require_manual_operator_present",
    "evidence_reference",
    "expires_monotonic_ns"
  ]
}
