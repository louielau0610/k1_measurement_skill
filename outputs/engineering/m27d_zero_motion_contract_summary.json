{
  "milestone": "M27-D",
  "contract_type": "zero_motion_bench",
  "created_at": "2026-06-18",
  "zero_motion_enforcement": {
    "runtime_boundary": true,
    "binding_boundary": true,
    "bench_runner_boundary": true,
    "tolerance": 1e-9,
    "error_code": "k1_m27d_nonzero_motion_forbidden",
    "forbidden_vx_mps": [0.35, 0.40, 0.50, 0.60],
    "forbidden_vy_mps": "any non-zero",
    "forbidden_wz_radps": "any non-zero"
  },
  "zero_motion_state_semantics": {
    "generic_zero_velocity_dispatch": {
      "accepted_receipt_field": "zero_command_accepted",
      "moves_to_moving": false,
      "state_preservation": ["idle", "locomotion_ready"],
      "physical_stop_claimed": false
    },
    "explicit_stop": {
      "accepted_receipt_field": "stop_command_accepted",
      "internal_command_state_allowed": "safe_stopped",
      "internal_state_is_physical_evidence": false
    }
  },
  "safe_state_evidence": {
    "stop_command_accepted_means": "SDK call returned without reported rejection",
    "internal_safe_state_claim": "command-derived software state",
    "physical_safe_state_observed_requires": "independent post-command telemetry",
    "default_when_no_independent_signal": {
      "physical_safe_state_observed": false,
      "physical_safe_state_verification": "unavailable",
      "bench_status": "safe_state_unverified"
    }
  },
  "required_confirmations": [
    "operator_confirmed_hardware",
    "physical_estop_confirmed",
    "clear_test_area_confirmed",
    "battery_state_confirmed",
    "network_isolation_confirmed",
    "manual_operator_present"
  ],
  "required_flags": [
    "enable_vendor_runtime",
    "execute_hardware"
  ],
  "artifact_schema": {
    "manifest": "m27d_manifest.json",
    "gate_evidence": "m27d_gate_evidence.json",
    "sdk_detection": "m27d_sdk_detection.json",
    "runtime_trace": "m27d_runtime_trace.jsonl",
    "telemetry_snapshot": "m27d_telemetry_snapshot.json",
    "result_summary": "m27d_result_summary.json"
  },
  "result_statuses": [
    "not_executed",
    "blocked_by_gate",
    "sdk_unavailable",
    "sdk_import_failed",
    "binding_construction_failed",
    "connection_failed",
    "read_only_checks_failed",
    "stop_unacknowledged",
    "safe_state_unverified",
    "bench_passed"
  ],
  "prohibited_content": [
    "secrets",
    "credentials",
    "raw_sdk_object_reprs",
    "memory_addresses",
    "uncontrolled_tracebacks"
  ]
}
