{
  "contract_version": "measurement_v1.0",
  "description": "Cross-platform measurement data contract for the calibration claw project.",
  "scope": "Step 1 — measurement module only. Not compensation.",
  "coordinate_convention": {
    "body_x": "forward",
    "body_y": "left",
    "body_z": "up",
    "yaw_internal_unit": "radians",
    "yaw_export_unit": "degrees",
    "forward_displacement_method": "projection_onto_initial_heading"
  },
  "trial_fields": {
    "schema_version": {"type": "string", "required": true, "description": "Contract version string"},
    "dataset_id": {"type": "string", "required": true, "description": "Dataset identifier"},
    "session_id": {"type": "string", "required": true, "description": "Session identifier"},
    "trial_id": {"type": "string", "required": true, "description": "Unique trial identifier"},
    "platform": {"type": "string", "required": true, "description": "Platform identifier (booster_k1, unitree_go1, unitree_g1)"},
    "robot_model": {"type": "string", "required": true, "description": "Robot model name"},
    "robot_id": {"type": "string", "required": true, "description": "Individual robot identifier"},
    "surface_type": {"type": "string", "required": true, "description": "Surface type (lab_hard_floor, marble_floor, artificial_turf, etc.)"},
    "environment_id": {"type": "string", "required": true, "description": "Environment identifier"},
    "command_velocity_mps": {"type": "float", "required": true, "unit": "m/s", "description": "Commanded forward velocity"},
    "measured_actual_velocity_mps": {"type": "float", "required": true, "unit": "m/s", "description": "Measured actual forward velocity"},
    "tracking_error_mps": {"type": "float", "required": true, "unit": "m/s", "description": "measured - command"},
    "relative_tracking_error": {"type": "float", "required": true, "description": "tracking_error / command_velocity"},
    "yaw_drift_deg": {"type": "float", "required": true, "unit": "degrees", "description": "Yaw drift during command window (odometer)"},
    "imu_yaw_drift_deg": {"type": "float", "required": true, "unit": "degrees", "description": "Yaw drift during command window (IMU)"},
    "state_source": {"type": "string", "required": true, "description": "ROS topic or SDK source for state measurement"},
    "command_source": {"type": "string", "required": true, "description": "Source of velocity commands"},
    "measurement_source": {"type": "string", "required": true, "description": "Primary measurement data source"},
    "measurement_method": {"type": "string", "required": true, "description": "Method used to extract velocity from state data"},
    "analysis_window_start_sec": {"type": "float", "required": true, "unit": "seconds", "description": "Start of analysis window relative to trial start"},
    "analysis_window_end_sec": {"type": "float", "required": true, "unit": "seconds", "description": "End of analysis window relative to trial start"},
    "state_log_path": {"type": "string", "required": true, "description": "Relative path to state log file"},
    "raw_log_path": {"type": "string", "required": true, "description": "Relative path to raw data log, or 'unavailable'"},
    "extraction_status": {"type": "enum", "required": true, "values": ["ok", "invalid_trial", "missing_log", "insufficient_samples", "missing_state_source", "extraction_error", "not_extracted"]},
    "confidence": {"type": "string", "required": true, "description": "Measurement confidence label"},
    "invalid_reason": {"type": "string", "required": true, "description": "Reason if trial is invalid, else empty"},
    "created_at": {"type": "string", "required": true, "description": "ISO 8601 timestamp"}
  },
  "aggregate_fields": {
    "schema_version": {"type": "string", "required": true},
    "dataset_id": {"type": "string", "required": true},
    "platform": {"type": "string", "required": true},
    "robot_model": {"type": "string", "required": true},
    "surface_type": {"type": "string", "required": true},
    "command_velocity_mps": {"type": "float", "required": true, "unit": "m/s"},
    "n": {"type": "int", "required": true, "description": "Number of trials in aggregate"},
    "mean_actual_velocity_mps": {"type": "float", "required": true, "unit": "m/s"},
    "std_actual_velocity_mps": {"type": "float", "required": true, "unit": "m/s"},
    "median_actual_velocity_mps": {"type": "float", "required": true, "unit": "m/s"},
    "min_actual_velocity_mps": {"type": "float", "required": true, "unit": "m/s"},
    "max_actual_velocity_mps": {"type": "float", "required": true, "unit": "m/s"},
    "mean_tracking_error_mps": {"type": "float", "required": true, "unit": "m/s"},
    "mean_abs_tracking_error_mps": {"type": "float", "required": true, "unit": "m/s"},
    "relative_tracking_error": {"type": "float", "required": true},
    "under_tracking_ratio": {"type": "float", "required": true},
    "no_motion_ratio": {"type": "float", "required": true},
    "mean_yaw_drift_deg": {"type": "float", "required": true, "unit": "degrees"},
    "std_yaw_drift_deg": {"type": "float", "required": true, "unit": "degrees"},
    "max_yaw_drift_deg": {"type": "float", "required": true, "unit": "degrees"},
    "response_uncertainty": {"type": "float", "required": true},
    "risk_score": {"type": "float", "required": true},
    "region_label": {"type": "string", "required": true},
    "evidence_level": {"type": "string", "required": true},
    "limitations": {"type": "string", "required": true}
  },
  "session_metadata_fields": {
    "schema_version": {"type": "string", "required": true},
    "session_id": {"type": "string", "required": true},
    "dataset_id": {"type": "string", "required": true},
    "platform": {"type": "string", "required": true},
    "robot_model": {"type": "string", "required": true},
    "robot_id": {"type": "string", "required": true},
    "surfaces": {"type": "list[string]", "required": true},
    "speeds_mps": {"type": "list[float]", "required": true, "unit": "m/s"},
    "repeats": {"type": "int", "required": true},
    "block_order": {"type": "string", "required": true},
    "timing": {"type": "object", "required": true, "fields": ["idle_sec", "command_sec", "stop_sec"]},
    "command_source": {"type": "string", "required": true},
    "state_sources": {"type": "list[string]", "required": true},
    "coordinate_convention": {"type": "object", "required": true},
    "state_frame": {"type": "string", "required": true},
    "body_frame": {"type": "string", "required": true},
    "measurement_method": {"type": "string", "required": true},
    "analysis_window": {"type": "object", "required": true},
    "hardware_validated_reference": {"type": "bool", "required": true},
    "operator_notes": {"type": "string", "required": true},
    "limitations": {"type": "list[string]", "required": true},
    "created_at": {"type": "string", "required": true}
  },
  "phase_gates": {
    "velocity_compensation_ready": false,
    "unitree_go1_measurement_ready": false,
    "unitree_g1_measurement_ready": false,
    "cross_platform_empirical_validation": false
  }
}
