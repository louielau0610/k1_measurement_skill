{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:calibration-skill:schema:operator_authorization:v1",
  "title": "Operator Authorization",
  "description": "Operator authorization record v1.0.0",
  "type": "object",
  "required": [
    "authorization_id", "operator_id", "platform", "robot_id",
    "issued_monotonic_ns", "expiry_monotonic_ns",
    "authorized_operations", "safety_policy_id", "safety_policy_hash",
    "evidence_reference"
  ],
  "properties": {
    "authorization_id": {"type": "string", "minLength": 1},
    "operator_id": {"type": "string", "minLength": 1},
    "platform": {"type": "string", "enum": ["booster_k1", "unitree_g1", "unitree_go1", "mock"]},
    "robot_id": {"type": "string", "minLength": 1},
    "issued_monotonic_ns": {"type": "integer", "minimum": 0},
    "expiry_monotonic_ns": {"type": "integer", "minimum": 0},
    "authorized_operations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "safety_policy_id": {"type": "string", "minLength": 1},
    "safety_policy_hash": {"type": "string", "minLength": 1},
    "evidence_reference": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
