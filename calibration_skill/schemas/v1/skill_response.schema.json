{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:calibration-skill:schema:skill_response:v1",
  "title": "Skill Response Envelope",
  "description": "Agent-callable skill response envelope v1.0.0",
  "type": "object",
  "required": ["schema_version", "request_id", "operation", "status"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["success", "rejected", "failed"]
    },
    "result": {
      "description": "Operation result (present on success)"
    },
    "error": {
      "$ref": "urn:calibration-skill:schema:error:v1"
    },
    "warnings": {
      "type": "array",
      "items": {"type": "string"}
    },
    "audit_reference": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"status": {"const": "success"}},
        "required": ["status"]
      },
      "then": {
        "properties": {"error": {"not": {}}}
      }
    },
    {
      "if": {
        "properties": {"status": {"enum": ["rejected", "failed"]}},
        "required": ["status"]
      },
      "then": {
        "required": ["error"]
      }
    }
  ]
}
