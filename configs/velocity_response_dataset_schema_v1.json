{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/k1_measurement/velocity_response_dataset_schema_v1.json",
  "title": "K1 velocity response dataset schema v1",
  "description": "Research foundation schema for forward velocity response modeling datasets. This schema records measurements only and does not define compensation, inverse command mapping, navigation control, or safe command adapter behavior.",
  "x_project_validation": {
    "minimum_viable_record_fields": [
      "vx_cmd_mps",
      "measurement_source",
      "localization_source",
      "environment_label"
    ],
    "either_or_field_groups": [
      [
        "robot_model",
        "robot_id"
      ],
      [
        "vx_actual_mps_mean",
        "qualitative_response_label"
      ],
      [
        "confidence_label",
        "confidence_score"
      ],
      [
        "trial_count",
        "sample_count"
      ]
    ],
    "false_only_record_fields": [
      "compensation_ready",
      "inverse_command_mapping_ready",
      "navigation_control_ready",
      "safe_command_adapter_ready"
    ],
    "optional_fields": [
      "battery_state"
    ],
    "disallowed_fields": [
      "remote_controller_state",
      "hand_controller_state",
      "unconfirmed_ros2_topic"
    ]
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "created_at",
    "research_problem",
    "robot",
    "environment",
    "acquisition",
    "command_grid",
    "trials",
    "quality",
    "downstream_boundaries"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "research_problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "response_equation",
        "modeling_goal",
        "claim_level"
      ],
      "properties": {
        "response_equation": {
          "type": "string",
          "const": "v_actual = f(v_cmd, environment, robot_state)"
        },
        "modeling_goal": {
          "type": "string",
          "enum": [
            "velocity_response_characterization"
          ]
        },
        "claim_level": {
          "type": "string",
          "enum": [
            "planned_schema_only",
            "measurement_dataset",
            "analysis_ready_dataset"
          ]
        }
      }
    },
    "robot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "identifier",
        "firmware_version",
        "control_mode"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "examples": [
            "Booster K1"
          ]
        },
        "identifier": {
          "type": "string"
        },
        "firmware_version": {
          "type": "string"
        },
        "control_mode": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "floor_type",
        "condition",
        "slope",
        "test_distance_m",
        "ground_truth_method",
        "notes"
      ],
      "properties": {
        "floor_type": {
          "type": "string",
          "enum": [
            "tile",
            "concrete",
            "wood",
            "carpet",
            "rubber",
            "unknown"
          ]
        },
        "condition": {
          "type": "string",
          "enum": [
            "dry",
            "wet",
            "dusty",
            "uneven",
            "unknown"
          ]
        },
        "slope": {
          "type": "string",
          "enum": [
            "flat",
            "mild_uphill",
            "mild_downhill",
            "unknown"
          ]
        },
        "test_distance_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "ground_truth_method": {
          "type": "string",
          "enum": [
            "tape_measure_video",
            "uwb",
            "motion_capture",
            "external_tracking",
            "unknown"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_id",
        "raw_log_reference",
        "normalized_log_reference",
        "topic_mapping_reference",
        "operator_confirmation"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "raw_log_reference": {
          "type": "string"
        },
        "normalized_log_reference": {
          "type": "string"
        },
        "topic_mapping_reference": {
          "type": "string"
        },
        "operator_confirmation": {
          "type": "boolean"
        }
      }
    },
    "command_grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vx_cmd_mps_values",
        "vy_cmd_mps",
        "wz_cmd_rps",
        "trials_per_command"
      ],
      "properties": {
        "vx_cmd_mps_values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "number",
            "minimum": 0
          }
        },
        "vy_cmd_mps": {
          "type": "number",
          "const": 0
        },
        "wz_cmd_rps": {
          "type": "number",
          "const": 0
        },
        "trials_per_command": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "trials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trial_id",
          "session_id",
          "vx_cmd_mps",
          "start_time",
          "end_time",
          "duration_sec",
          "distance_m",
          "vx_actual_mean_mps",
          "vx_actual_std_mps",
          "sample_count",
          "robot_state",
          "quality_flags"
        ],
        "properties": {
          "trial_id": {
            "type": "string",
            "minLength": 1
          },
          "session_id": {
            "type": "string",
            "minLength": 1
          },
          "vx_cmd_mps": {
            "type": "number",
            "minimum": 0
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          },
          "duration_sec": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "distance_m": {
            "type": "number",
            "minimum": 0
          },
          "vx_actual_mean_mps": {
            "type": "number"
          },
          "vx_actual_std_mps": {
            "type": "number",
            "minimum": 0
          },
          "sample_count": {
            "type": "integer",
            "minimum": 1
          },
          "robot_state": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "mode",
              "gait"
            ],
            "properties": {
              "mode": {
                "type": "string"
              },
              "gait": {
                "type": "string"
              },
              "battery_state": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "percentage"
                ],
                "properties": {
                  "percentage": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  },
                  "voltage_v": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  }
                }
              },
              "load_state": {
                "type": "string"
              }
            }
          },
          "quality_flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_confidence",
        "known_limitations",
        "excluded_trials"
      ],
      "properties": {
        "dataset_confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "known_limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excluded_trials": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trial_id",
              "reason"
            ],
            "properties": {
              "trial_id": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "downstream_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compensation_logic_included",
        "inverse_command_mapping_included",
        "navigation_control_included",
        "safe_command_adapter_included",
        "publication_ready_claim"
      ],
      "properties": {
        "compensation_logic_included": {
          "type": "boolean",
          "const": false
        },
        "inverse_command_mapping_included": {
          "type": "boolean",
          "const": false
        },
        "navigation_control_included": {
          "type": "boolean",
          "const": false
        },
        "safe_command_adapter_included": {
          "type": "boolean",
          "const": false
        },
        "publication_ready_claim": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
